{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/tmux-agent-watcher.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/tmux-tab-namer.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/gray.karegeannes/.claude/hooks/carl-hook.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "analyze-project@lt-claude-code-skills": false,
    "branch-comparison@lt-claude-code-skills": false,
    "github@lt-claude-code-skills": false,
    "jira-work-tracker@lt-claude-code-skills": true,
    "mermaid-html@lt-claude-code-skills": false
  },
  "extraKnownMarketplaces": {
    "lt-claude-code-skills": {
      "source": {
        "source": "github",
        "repo": "LocumTenens-com/LT-Claude-Code-Skills"
      }
    }
  },
  "tui": "default",
  "skipDangerousModePermissionPrompt": true
}
