    "margin-right": 10,
    "spacing": 0,
    "reload_style_on_change": true,
    "modules-left": ["group/workspaces"],
    "modules-center": [],
    "modules-right": ["custom/brightness", "group/status", "group/clock"],
    "include": ["~/.config/waybar/modules.jsonc"],
    "custom/brightness": {
      "format": "󰃠 {}",
      "return-type": "json",
      "exec": "~/.config/waybar/scripts/brightness.sh DP-5",
      "on-scroll-up": "~/.config/waybar/scripts/brightness.sh DP-5 up",
      "on-scroll-down": "~/.config/waybar/scripts/brightness.sh DP-5 down",
      "interval": 30
    }
  },
