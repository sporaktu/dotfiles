[
  {
    "output": "HDMI-A-2",
    "position": "top",
    "height": 34,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "reload_style_on_change": true,
    "modules-left": ["group/workspaces"],
    "modules-center": ["group/media"],
    "modules-right": ["group/system", "custom/brightness", "group/status", "group/clock"],
    "include": ["~/.config/waybar/modules.jsonc"],
    "custom/brightness": {
      "format": "󰃠 {}",
      "return-type": "json",
      "exec": "~/.config/waybar/scripts/brightness.sh HDMI-A-2",
      "on-scroll-up": "~/.config/waybar/scripts/brightness.sh HDMI-A-2 up",
      "on-scroll-down": "~/.config/waybar/scripts/brightness.sh HDMI-A-2 down",
      "interval": 30
    }
  },
  {
    "output": "DP-5",
    "position": "top",
