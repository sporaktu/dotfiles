    "modules-left": ["group/workspaces"],
    "modules-center": [],
    "modules-right": ["custom/brightness", "group/status", "group/clock"],
    "include": ["~/.config/waybar/modules.jsonc"],
    "custom/brightness": {
      "format": "󰃠 {}",
      "return-type": "json",
      "exec": "~/.config/waybar/scripts/brightness.sh DP-6",
      "on-scroll-up": "~/.config/waybar/scripts/brightness.sh DP-6 up",
