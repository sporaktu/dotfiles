diff --git a/tests/timerpool.test.cjs b/tests/timerpool.test.cjs
new file mode 100644
index 0000000..7907b58
--- /dev/null
+++ b/tests/timerpool.test.cjs
@@ -0,0 +1,74 @@
+/*
+    SPDX-FileCopyrightText: 2026 Krohnkite contributors
+
+    SPDX-License-Identifier: MIT
+*/
+
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const { test } = require('node:test');
+const ts = require('typescript');
+
+const ROOT = path.resolve(__dirname, '..');
+
+// After a script reload, script.js's globals can still point at the previous
+// instance: `scriptRoot` is that instance's destroyed root item. Creating a
+// timer under it fails with "Missing parent object", which silently drops
+// every deferred call (enforceSize, forced arrange).
+function loadPool() {
+  const source = ts.transpileModule(
+    fs.readFileSync(path.join(ROOT, 'src/driver/kwinsettimeout.ts'), 'utf8'),
+    { compilerOptions: { target: ts.ScriptTarget.ES2015 } },
+  ).outputText;
+  const deadRoot = { destroyed: true };
+  const liveRoot = { destroyed: false };
+  const created = [];
+  const Qt = {
+    createQmlObject(_qml, parent) {
+      if (!parent || parent.destroyed)
+        throw new Error('Qt.createQmlObject(): Missing parent object');
+      const handlers = [];
+      const timer = {
+        parent,
+        interval: 0,
+        repeat: true,
+        triggered: {
+          connect: (fn) => handlers.push(fn),
+          disconnect: (fn) => handlers.splice(handlers.indexOf(fn), 1),
+        },
+        start() {},
+        stop() {},
+        destroy() {},
+        fire: () => handlers.slice().forEach((fn) => fn()),
+      };
+      created.push(timer);
+      return timer;
+    },
+  };
+  const context = vm.createContext({ Qt, scriptRoot: deadRoot, LOG: undefined });
+  const KWinTimerPool = vm.runInContext(`${source}\nKWinTimerPool`, context);
+  return { KWinTimerPool, liveRoot, created };
+}
+
+test('timers are parented to the live root, not a stale scriptRoot global', () => {
+  const { KWinTimerPool, liveRoot, created } = loadPool();
+  KWinTimerPool.instance.setParent(liveRoot);
+
+  let ran = false;
+  KWinTimerPool.instance.setTimeout(() => (ran = true), 10);
+
+  assert.equal(created.length, 1);
+  assert.equal(created[0].parent, liveRoot);
+  created[0].fire();
+  assert.equal(ran, true);
+});
+
+test('without a parent it falls back to the scriptRoot global', () => {
+  const { KWinTimerPool } = loadPool();
+  assert.throws(
+    () => KWinTimerPool.instance.setTimeout(() => {}, 10),
+    /Missing parent object/,
+  );
+});
